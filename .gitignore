!**/fixtures/synthetic/**/*.mp3
!**/fixtures/synthetic/**/*.flac
!**/fixtures/synthetic/**/*.ogg
!**/fixtures/synthetic/**/*.m4a
!**/fixtures/synthetic/**/*.webm

