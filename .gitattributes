# Normalise line endings in the repository to LF
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary

# Generated files: collapse in diffs
uv.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
contracts/openapi.json linguist-generated=true
apps/web/src/lib/api/schema.d.ts linguist-generated=true
